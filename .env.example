# CoinGecko API (Optional - Demo API works without key or with demo key)
COINGECKO_API_KEY=

# DefiLlama requires no key for open endpoints

# Google Gemini API key (Free tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional GitHub Token (increases rate limit from 60 to 5,000 req/hr for developer activity analysis)
GITHUB_TOKEN=

# Optional Telegram Notifications (bot token from @BotFather, chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cache and output settings
DATA_DIR=./data
REPORTS_DIR=./reports
CACHE_TTL_HOURS=6
