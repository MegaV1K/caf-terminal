@echo off
chcp 65001 > nul
echo ========================================================
echo        CAF-TERMINAL: АВТОМАТИЧЕСКИЙ ЗАПУСК РАДАРА
echo ========================================================
cd /d "%~dp0"

if not exist ".venv\Scripts\python.exe" (
    echo [ОШИБКА] Виртуальное окружение .venv не найдено!
    pause
    exit /b 1
)

echo Запуск полного аналитического цикла (Радар + Комитет + База данных)...
".venv\Scripts\python.exe" scripts/scheduler.py --once

echo.
echo ========================================================
echo [ГОТОВО] Все отчеты сохранены в папке reports/
echo ========================================================
pause
